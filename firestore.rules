rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 掲示板（bb-*）は 2026-07-10 にアプリごと削除済み。
    // ルールに match がないパスはデフォルトで全拒否される。

    // ことば探偵 — ルームコード共有型ゲーム
    match /kotobatantei_rooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
