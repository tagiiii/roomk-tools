rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 掲示板コレクション — クローズドコミュニティ向け全開放
    match /bb-users/{userId} {
      allow read, write: if true;
    }
    match /bb-invite-codes/{code} {
      allow read, write: if true;
    }
    match /bb-threads/{threadId} {
      allow read, write: if true;
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }

    // ことば探偵 — ルームコード共有型ゲーム
    match /codenames_rooms/{roomId} {
      allow read, write: if true;
    }
  }
}
